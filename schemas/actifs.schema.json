{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inventaire des actifs",
  "type": "object",
  "required": ["version", "date_revue", "actifs"],
  "properties": {
    "version": {"type": "string"},
    "date_revue": {"type": "string", "format": "date"},
    "actifs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "nom", "type", "proprietaire", "classification", "dict"],
        "properties": {
          "id": {"type": "string", "pattern": "^A[0-9]{2}$"},
          "type": {"enum": ["application", "donnees", "service", "processus", "infrastructure", "fournisseur"]},
          "classification": {"enum": ["public", "interne", "confidentiel", "secret"]},
          "dict": {
            "type": "object",
            "required": ["D", "I", "C", "T"],
            "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 4}
          }
        }
      }
    }
  }
}
