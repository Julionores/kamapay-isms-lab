{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Historique des indicateurs du SMSI",
  "type": "object",
  "required": ["releves"],
  "properties": {
    "releves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "source", "indicateurs"],
        "additionalProperties": false,
        "properties": {
          "date": {"type": "string", "format": "date"},
          "source": {"enum": ["ci", "manuel"]},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
          "indicateurs": {
            "type": "object",
            "propertyNames": {"pattern": "^KPI-[0-9]{2}$"},
            "additionalProperties": {"type": ["number", "null"]}
          },
          "controles": {
            "type": "object",
            "required": ["conformes", "total", "non_conformes"],
            "properties": {
              "conformes": {"type": "integer", "minimum": 0},
              "total": {"type": "integer", "minimum": 0},
              "non_conformes": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
