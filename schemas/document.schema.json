{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Métadonnées d'un document du SMSI (clause 7.5)",
  "type": "object",
  "required": ["id", "titre", "version", "statut", "classification", "proprietaire", "approbateur", "date_approbation", "prochaine_revue", "controles_iso"],
  "properties": {
    "id": {"type": "string", "minLength": 2},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "statut": {"enum": ["brouillon", "approuve"]},
    "classification": {"enum": ["public", "interne", "confidentiel", "secret"]},
    "date_approbation": {"type": "string", "format": "date"},
    "prochaine_revue": {"type": "string", "format": "date"},
    "controles_iso": {"type": "array", "items": {"type": "string", "pattern": "^[5-8]\\.[0-9]{1,2}$"}}
  }
}
